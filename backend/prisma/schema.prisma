generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

model Booking {
  id        String        @id @default(uuid())
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  
  start     DateTime
  end       DateTime
  
  status    BookingStatus @default(PENDING)
  
  // Customer Info
  name      String
  email     String
  phone     String
  notes     String?

  @@index([start, end])
  @@index([status])
}
